rules_version = '2';

// Aturan Firestore untuk komentar pengunjung.
// Ini perlindungan SISI SERVER (tidak bisa dilewati bot): pengunjung hanya boleh
// membaca dan MENAMBAH komentar dengan bentuk data yang ketat. Tidak boleh mengubah
// atau menghapus. Hapus hanya untuk akun admin Firebase.
//
// Cara pasang: Firebase Console > Firestore Database > Rules > tempel isi file ini
// (ganti GANTI_DENGAN_EMAIL_ADMIN_FIREBASE dengan email akun admin) > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /comments/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(10, 'm')
        && request.resource.data.createdAt < request.time + duration.value(10, 'm');

      allow update: if false;

      allow delete: if request.auth != null
        && request.auth.token.email == 'fadilataufan14@gmail.com';
    }

    // semua koleksi lain tertutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
